DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linji_snow
KAFKA_BROKERS=localhost:9092
# Local broker is plaintext. Enable TLS before configuring SASL credentials.
KAFKA_TLS_ENABLED=false
KAFKA_TLS_CA_FILE=
KAFKA_TLS_CERT_FILE=
KAFKA_TLS_KEY_FILE=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_EVENTS_TOPIC=linji.integration-events
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP=linji-rag-indexer
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
LOGIN_RATE_LIMIT_SECRET=replace-with-a-separate-random-secret-at-least-32-bytes
# Empty means socket IP only; comma-separated explicit trusted proxy IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
REFRESH_TOKEN_TTL_SECONDS=2592000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=8080
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_API_KEY=
CHAT_MODEL_NAME=deepseek-flash
CHAT_MODEL_TIMEOUT_MS=120000
# DeepSeek extension; leave empty for other OpenAI-compatible providers.
CHAT_MODEL_THINKING=disabled
CHAT_MODEL_MAX_TOKENS=2048
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_MS=30000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linji-assets
S3_ACCESS_KEY_ID=linji-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-secret
S3_SERVER_SIDE_ENCRYPTION=false
# Total deadline per runtime PUT/DELETE; SDK retries are disabled; milliseconds.
S3_REQUEST_TIMEOUT_MS=30000
# Optional Go module proxy used only while building the local MinIO image.
MINIO_BUILD_GOPROXY=https://proxy.golang.org,direct
MINIO_BIND_ADDRESS=127.0.0.1
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Total scan deadline across connect, upload and response, not TCP idle time.
CLAMAV_TIMEOUT_MS=15000
INITIAL_ADMIN_ACCOUNT=
INITIAL_ADMIN_PASSWORD=
