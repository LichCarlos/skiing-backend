{
  "name": "@linji/api",
  "version": "0.0.1",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:source-export",
    "source:export": "node --experimental-strip-types scripts/export-source.ts",
    "test:source-export": "node --experimental-strip-types --test --test-concurrency=1 scripts/export-source.node-test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:backup": "node --experimental-strip-types scripts/database-backup.ts backup",
    "db:restore-new": "node --experimental-strip-types scripts/database-backup.ts restore-new",
    "test:database-recovery": "tsx scripts/validate-database-recovery.ts",
    "storage:init": "tsx scripts/init-asset-storage.ts",
    "storage:verify-recovery": "tsx scripts/verify-storage-recovery.ts",
    "rag:reindex": "tsx scripts/rag-reindex.ts",
    "ai:verify": "tsx scripts/verify-model-providers.ts",
    "openapi:generate": "pnpm build && node dist/openapi-export.js",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:independent-http": "tsx --test scripts/independent-start-http.ts",
    "test:container": "tsx scripts/validate-container.ts",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:db": "vitest run --config ./vitest.config.database.ts",
    "test:native-db": "tsx scripts/validate-native-postgres.ts",
    "test:native-storage": "tsx scripts/validate-native-storage.ts",
    "test:storage-recovery": "tsx scripts/validate-storage-recovery.ts",
    "test:native-public-http": "tsx scripts/validate-native-public-http.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:kafka-security": "vitest run --config ./vitest.config.kafka-security.ts",
    "test:rag-live": "vitest run --config ./vitest.config.rag-live.ts",
    "test:rag-backfill-live": "vitest run --config ./vitest.config.rag-backfill-live.ts",
    "test:rag-kafka-live": "vitest run --config ./vitest.config.kafka-rag-live.ts",
    "test:assets-integration": "vitest run --config ./vitest.config.assets-integration.ts",
    "test:storage-integration": "vitest run --config ./vitest.config.storage-integration.ts",
    "test:native-admin-http": "tsx scripts/validate-native-admin-http.ts",
    "test:native-kafka": "tsx scripts/validate-native-kafka.ts",
    "test:native-revenue-http": "tsx scripts/validate-native-revenue-http.ts",
    "test:native-resort-http": "tsx scripts/validate-native-resort-http.ts",
    "test:native-ai-http": "tsx scripts/validate-native-ai-http.ts",
    "source:verify": "node --experimental-strip-types scripts/export-source.ts --verify",
    "maintenance:rag": "tsx scripts/maintenance.ts rag",
    "maintenance:assets": "tsx scripts/maintenance.ts assets"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-parse": "^7.0.3",
    "kafkajs": "2.2.4",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "rxjs": "^7.8.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
