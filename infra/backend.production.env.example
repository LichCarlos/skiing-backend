# Private runtime file: replace every placeholder; keep outside the repository.
# Container localhost refers to this container, not the host or another service.
DATABASE_URL=postgresql://linji_api:REPLACE_PASSWORD@postgres.internal:5432/linji_snow?sslmode=require
KAFKA_BROKERS=kafka.internal:9093
KAFKA_TLS_ENABLED=true
# Empty CA uses Node default trust. Mount PEM files read-only for a private CA/mTLS.
KAFKA_TLS_CA_FILE=
KAFKA_TLS_CERT_FILE=
KAFKA_TLS_KEY_FILE=
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=REPLACE_KAFKA_USERNAME
KAFKA_SASL_PASSWORD=REPLACE_KAFKA_PASSWORD
KAFKA_EVENTS_TOPIC=linji.integration-events
KAFKA_CONSUMER_GROUP=linji-rag-indexer
KAFKA_CONSUMER_ENABLED=true
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=2592000
WEB_ORIGINS=https://www.example.com,https://admin.example.com,https://app.example.com
PORT=8080
CHAT_MODEL_BASE_URL=https://REPLACE_VERIFIED_PROVIDER/v1
CHAT_MODEL_API_KEY=REPLACE_CHAT_KEY
CHAT_MODEL_NAME=REPLACE_VERIFIED_DEEPSEEK_MODEL_ID
CHAT_MODEL_TIMEOUT_MS=120000
# Optional provider extension: enabled/disabled; empty omits the field.
CHAT_MODEL_THINKING=
CHAT_MODEL_MAX_TOKENS=2048
EMBEDDING_BASE_URL=https://REPLACE_VERIFIED_EMBEDDING_PROVIDER/v1
EMBEDDING_API_KEY=REPLACE_EMBEDDING_KEY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_MS=30000
S3_ENDPOINT=https://s3.internal.example.com
S3_PUBLIC_ENDPOINT=https://assets.example.com
S3_REGION=REPLACE_REGION
S3_BUCKET=linji-assets
S3_ACCESS_KEY_ID=REPLACE_STORAGE_KEY
S3_SECRET_ACCESS_KEY=REPLACE_STORAGE_SECRET
S3_SERVER_SIDE_ENCRYPTION=true
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Shared across all API replicas; rotate as a controlled deployment (resets windows).
LOGIN_RATE_LIMIT_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_32_BYTES_MINIMUM
# Explicit IP/CIDR list only, empty trusts socket IP only.
TRUSTED_PROXY_CIDRS=
